DATABASE_URL=postgres://ocr:ocr-local@localhost:5432/ocr
REDIS_PASSWORD=replace-with-a-random-hex-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
COMPOSE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_STREAM=ocr:jobs
REDIS_CONSUMER_GROUP=ocr-workers
REDIS_TIMEOUT_MS=2000
REDIS_REDISPATCH_SECONDS=30
OCR_API_TOKEN=replace-with-a-long-random-service-token
# Optional privileged review service credential; both unset disables review.
OCR_REVIEW_TOKEN=
OCR_REVIEW_PRINCIPAL=
# Separate metrics listeners. Non-loopback binds require a distinct strong token.
API_METRICS_BIND_ADDR=
WORKER_METRICS_BIND_ADDR=
METRICS_BEARER_TOKEN=
API_BIND_ADDR=0.0.0.0:8080
MAX_UPLOAD_BYTES=10485760
UPLOAD_TIMEOUT_SECONDS=30
UPLOAD_CONCURRENCY=8
MAX_PENDING_JOBS=1000
# Intake: lock < statement < total; total includes pool acquisition and COMMIT.
ENQUEUE_TIMEOUT_MS=10000
ENQUEUE_LOCK_TIMEOUT_MS=2000
ENQUEUE_STATEMENT_TIMEOUT_MS=5000
# API output/transport bounds. Separate small polling reserve; see A01 trace.
RESPONSE_SMALL_CONCURRENCY=32
RESPONSE_LARGE_CONCURRENCY=8
RESPONSE_SERIALIZATION_CONCURRENCY=4
RESPONSE_MAX_SMALL_BYTES=65536
RESPONSE_MAX_JSON_BYTES=16777216
RESPONSE_MAX_SOURCE_BYTES=52428800
RESPONSE_LARGE_RESERVED_BYTES=134217728
RESPONSE_READ_TIMEOUT_SECONDS=10
RESPONSE_BODY_TIMEOUT_SECONDS=30
HTTP_MAX_CONNECTIONS=128
HTTP_WRITE_BUFFER_BYTES=65536
HTTP_HEADER_TIMEOUT_SECONDS=10
HTTP_WRITE_STALL_TIMEOUT_SECONDS=10
HTTP_CONNECTION_LIFETIME_SECONDS=120
# Use the exact served model name exposed by your inference server.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3.5-4B
VLLM_API_KEY=
# Immutable deployment fingerprint: weights/tokenizer/runtime/server settings.
# Change whenever inference behavior changes. Required when checkpoints enabled.
INFERENCE_REVISION=
# Optional bounded JSON declaration of runtime/weights/quantization/scheduler limits.
# Operator-declared, NOT verified by /v1/models. See docs/observability.md.
INFERENCE_DEPLOYMENT_JSON=
REGION_CHECKPOINTS_ENABLED=false
# Extra expanded-crop observations; raw OCR is preserved, no automatic selection.
REGION_RECOVERY_MAX_REGIONS=0
REGION_RECOVERY_EXPANSION_PIXELS=16
# Must not exceed PARSER_MAX_SESSIONS; the worker refuses to start otherwise.
WORKER_CONCURRENCY=2
# Concurrent documents in the isolated parser container (1..=64).
PARSER_MAX_SESSIONS=8
LEASE_SECONDS=60
MAX_ATTEMPTS=3
POLL_INTERVAL_MS=500
REQUEST_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=600
MAX_PAGES=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_EDGE=2000
# Course layout is the default. full_page_vlm is the explicit legacy/demo path.
OCR_STRATEGY=course_layout_vlm
# Run bash scripts/setup-layout-model.sh before starting the course worker.
# Setup writes the actual export hash and an absolute LAYOUT_MODEL_DIR to .env.
LAYOUT_MODEL_DIR=./artifacts/models/pp-doclayout-v3
LAYOUT_MODEL_PATH=./artifacts/models/pp-doclayout-v3/model.onnx
LAYOUT_MODEL_SHA256=98798e25d88318d44c68cb0d63242026b6006246bd83390365d894d459efb43c
PDF_RENDER_DPI=200
PAGE_MAX_EDGE=3500
LAYOUT_TIMEOUT_SECONDS=60
# Warm Rust helper processes; bounded by WORKER_CONCURRENCY. Each keeps one ONNX session.
LAYOUT_POOL_SIZE=1
MAX_REGIONS_PER_PAGE=128
MAX_REGIONS_PER_DOCUMENT=2048
REGION_CONCURRENCY=4
# false preserves the course's chart/image skip policy; true recognizes crops.
OCR_RECOGNIZE_IMAGES=false
TABLE_CROP_PADDING_PIXELS=0
PDF_RENDER_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=8192
# Legacy configured value only; automatic pruning is disabled pending A04 policy.
RETENTION_DAYS=7
RUST_LOG=info
