        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predictionObservation"
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1,
          "maxItems": 256
        }
      }
    }
  }
