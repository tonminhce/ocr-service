# Non-secret deployment settings only. Do not copy current development .env.
PROD_IMAGE=ocr-service:a05
PROD_SECRETS_DIR=./artifacts/production-secrets
PROD_API_PORT=8180
PROD_API_METRICS_PORT=9191
PROD_WORKER_METRICS_PORT=9192
PROD_LAYOUT_MODEL_DIR=./artifacts/models/pp-doclayout-v3
# Copy the SHA from the reviewed layout manifest; worker verifies the actual file.
PROD_LAYOUT_MODEL_SHA256=
PROD_VLLM_BASE_URL=http://host.docker.internal:8000/v1
PROD_VLLM_MODEL=Qwen/Qwen3.5-4B
PROD_INFERENCE_REVISION=
PROD_REGION_CHECKPOINTS_ENABLED=false
PROD_REVIEW_PRINCIPAL=production-review-service
# Isolated parser document sessions; worker concurrency must not exceed it.
PROD_PARSER_MAX_SESSIONS=8
PROD_RUST_LOG=info
