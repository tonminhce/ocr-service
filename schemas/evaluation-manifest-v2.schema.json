            "nfc-typed/1.0.0"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "machine_only": {
          "enum": [
            true
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "transcripts": {
          "type": "array",
