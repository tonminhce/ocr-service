DATABASE_URL=postgres://ocr:ocr-local@localhost:5432/ocr
REDIS_PASSWORD=replace-with-a-random-hex-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
COMPOSE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_STREAM=ocr:jobs
REDIS_CONSUMER_GROUP=ocr-workers
REDIS_TIMEOUT_MS=2000
REDIS_REDISPATCH_SECONDS=30
OCR_API_TOKEN=replace-with-a-long-random-service-token
# Optional privileged review; use a separate random token of at least 32 characters.
OCR_REVIEW_TOKEN=
OCR_REVIEW_PRINCIPAL=
# Docker listeners are optional; 0.0.0.0 binds require METRICS_BEARER_TOKEN.
API_METRICS_BIND_ADDR=
WORKER_METRICS_BIND_ADDR=
METRICS_BEARER_TOKEN=
VLLM_API_KEY=replace-with-a-different-random-model-token
VLLM_BASE_URL=http://127.0.0.1:8000/v1
COMPOSE_VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=Qwen/Qwen3.5-4B
# Set an immutable weights/tokenizer/runtime/server configuration revision before enabling.
INFERENCE_REVISION=
# Optional operator declaration; see docs/observability.md. Never contains secrets.
INFERENCE_DEPLOYMENT_JSON=
REGION_CHECKPOINTS_ENABLED=false
REGION_RECOVERY_MAX_REGIONS=0
REGION_RECOVERY_EXPANSION_PIXELS=16
WORKER_CONCURRENCY=1
OCR_STRATEGY=course_layout_vlm
# Run bash scripts/setup-layout-model.sh; it writes the actual hash/path to .env.
LAYOUT_MODEL_DIR=./artifacts/models/pp-doclayout-v3
LAYOUT_MODEL_PATH=./artifacts/models/pp-doclayout-v3/model.onnx
LAYOUT_MODEL_SHA256=98798e25d88318d44c68cb0d63242026b6006246bd83390365d894d459efb43c
PDF_RENDER_DPI=200
PAGE_MAX_EDGE=3500
MAX_IMAGE_EDGE=2000
MAX_IMAGE_PIXELS=40000000
MAX_PAGES=20
LAYOUT_TIMEOUT_SECONDS=60
LAYOUT_POOL_SIZE=1
MAX_REGIONS_PER_PAGE=128
MAX_REGIONS_PER_DOCUMENT=2048
REGION_CONCURRENCY=1
OCR_RECOGNIZE_IMAGES=false
# Explicit local model compatibility extension; strict course profile uses 0.
TABLE_CROP_PADDING_PIXELS=112
PDF_RENDER_TIMEOUT_SECONDS=30
# Legacy configured value only; automatic pruning is disabled pending A04 policy.
RETENTION_DAYS=7
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=300
JOB_TIMEOUT_SECONDS=1200
WORKER_STOP_GRACE_PERIOD=1210s
VLLM_IMAGE_MAX_PIXELS=1572864
VLLM_MAX_BATCHED_TOKENS=2048
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.5
RUST_LOG=info
